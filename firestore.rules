rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReport(data) {
      return data.keys().hasAll(['orgUnitId', 'period', 'dataSetId', 'status', 'values', 'completedBy', 'lastUpdated']) &&
             data.orgUnitId is string && data.orgUnitId.size() <= 100 &&
             data.period is string && data.period.size() <= 20 &&
             data.dataSetId is string && data.dataSetId.size() <= 100 &&
             data.values is map &&
             data.status in ['COMPLETE', 'INCOMPLETE'] &&
             data.completedBy == request.auth.token.email &&
             data.lastUpdated == request.time &&
             (data.keys().hasAny(['completedAt']) ? (data.status == 'COMPLETE' ? data.completedAt == request.time : data.completedAt == null) : true);
    }

    // --- Match Blocks ---
    match /reports/{reportId} {
      allow get: if isSignedIn();
      
      allow list: if isSignedIn() && (
        resource.data.completedBy == request.auth.token.email
      );

      allow create: if isSignedIn() && 
                    isValidId(reportId) && 
                    isValidReport(incoming());

      allow update: if isSignedIn() && 
                    isValidReport(incoming()) && 
                    existing().status != 'COMPLETE' && 
                    incoming().orgUnitId == existing().orgUnitId &&
                    incoming().period == existing().period &&
                    incoming().dataSetId == existing().dataSetId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['values', 'status', 'completedAt', 'lastUpdated']);
      
      allow delete: if false;
    }
  }
}
